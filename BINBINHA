def executar_cmd(comando, timeout_custom=15):
    try:
        res = subprocess.run(comando, shell=True, capture_output=True, text=True, timeout=timeout_custom)
        return res.stdout.strip()
    except:
        return ""

def animar_progresso(etapa, progresso_atual, total_etapas):
    porcentagem = int((progresso_atual / total_etapas) * 100)
    blocos = int(porcentagem / 5)
    barra = "█" * blocos + "░" * (20 - blocos)
    
    exibir_banner()
    print(f"\n\033[1;34m: [ {barra} ]  {porcentagem}%  {progresso_atual}/{total_etapas}\033[0m")
    if progresso_atual > 1:
        print(f"\033[1;32m✓ Módulos anteriores verificados e consolidados com sucesso.\033[0m")
    else:
        print(f"\033[1;37m Inicializando motor de varredura heurística...\033[0m")
    print(f"\033[1;33m➤ {etapa}...\033[0m")
    time.sleep(1.8)

