#!/usr/bin/env python3
import subprocess
import os
import sys

def cabecalho():
    print("\033[1;36m=======================================================\033[0m")
    print("\033[1;35m      ░▒▓█  SCANNER BINBINHA ANTI-CHEAT v1.0  █▓▒░      \033[0m")
    print("\033[1;32m         Focado em Defesa, Transparência e Jogo Limpo   \033[0m")
    print("\033[1;36m=======================================================\033[0m")

def executar(comando):
    try:
        res = subprocess.run(comando, shell=True, capture_output=True, text=True, timeout=10)
        return res.stdout.strip()
    except:
        return ""

def verificar_requisitos():
    if not os.path.exists("/sdcard/Android"):
        print("\033[1;31m[-] ERRO: Permissão de armazenamento ausente.\033[0m")
        print("[!] Digite 'termux-setup-storage' no Termux e tente novamente.\n")
        sys.exit(1)

def checar_sistema():
    print("\n\033[1;33m[+] ANALISANDO CONFIGURAÇÕES DO DISPOSITIVO...\033[0m")
    adb = executar("settings get global adb_enabled")
    dev = executar("settings get global development_settings_enabled")
    
    if adb == "1":
        print("\033[1;31m[-] ALERTA: Depuração USB está ATIVADA (Permite injeção externa).\033[0m")
    else:
        print("\033[1;32m[✓] Depuração USB: Segura (Desativada).\033[0m")
        
    if dev == "1":
        print("[i] Opções de Desenvolvedor estão ativas no aparelho.")

def verificar_arquivos_ff():
    print("\n\033[1;33m[+] ESCANEANDO DIRETÓRIOS DO FREE FIRE...\033[0m")
    caminho_data = "/sdcard/Android/data/com.dts.freefireth"
    caminho_obb = "/sdcard/Android/obb/com.dts.freefireth"
    
    if not os.path.exists(caminho_data) and not os.path.exists(caminho_obb):
        print("[i] Nenhuma pasta de Free Fire encontrada neste dispositivo.")
        return

    print("[i] Verificando assinaturas de arquivos modificados e Regedit...")
    comando_busca = f"find {caminho_data} {caminho_obb} -type f \( -name '*.lua' -o -name '*regedit*' -o -name '*bypass*' -o -name '*aimbot*' -o -name '*modmenu*' \) 2>/dev/null"
    arquivos_suspeitos = executar(comando_busca)
    
    if arquivos_suspeitos:
        print("\033[1;31m[-] PERIGO: Arquivos não autorizados encontrados nas pastas do jogo:\033[0m")
        print(f"\033[0;31m{arquivos_suspeitos}\033[0m")
    else:
        print("\033[1;32m[✓] Integridade dos arquivos do jogo: Limpa e Original.\033[0m")

def analisar_logcat():
    print("\n\033[1;33m[+] EXTRAINDO LOGCAT (HISTÓRICO DE PROCESSOS)...\033[0m")
    print("[i] Analisando registros de memória em segundo plano...")
    gatilhos = "gameguardian|cheat|modmenu|bypass|inject|frida|cheatengine|lshook"
    logs = executar(f"logcat -d -t 500 2>/dev/null | grep -Ei '{gatilhos}'")
    
    if logs:
        print("\033[1;31m[-] DETECTADO: Rastros suspeitos encontrados na memória do sistema:\033[0m")
        linhas = logs.split("\n")[:5]
        for linha in linhas:
            print(f"    -> {linha}")
        if len(logs.split("\n")) > 5:
            print(f"    ... e mais {len(logs.split('\n')) - 5} linhas suspeitas.")
    else:
        print("\033[1;32m[✓] Memória ativa limpa. Nenhum injetor detectado em segundo plano.\033[0m")

def main():
    cabecalho()
    verificar_requisitos()
    checar_sistema()
    verificar_arquivos_ff()
    analisar_logcat()
    print("\n\033[1;36m=======================================================\033[0m")
    print("\033[1;32m      [✓] VARREDURA CONCLUÍDA PELO SCANNER BINBINHA    \033[0m")
    print("\033[1;36m=======================================================\033[0m")

if __name__ == "__main__":
    main()
