    blocos = int(porcentagem / 5)
    barra = "█" * blocos + "░" * (20 - blocos)
    
    exibir_banner()
    print(f"\n\033[1;34m [ {barra} ]  {porcentagem}%  {progresso_atual}/{total_etapas}\033[0m")
    if progresso_atual > 1:
        print(f"\033[1;32m✓ Assinaturas anteriores limpas e verificadas.\033[0m")
    else:
        print(f"\033[1;37m Desandando algoritmos de proteção heurística...\033[0m")
    print(f"\033[1;33m➤ {etapa}...\033[0m")
    time.sleep(1.5)

