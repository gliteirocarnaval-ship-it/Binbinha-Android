def executar_cmd(comando, timeout_custom=15):
    try:
        res = subprocess.run(comando, shell=True, capture_output=True, text=True, timeout=timeout_custom)
        return res.stdout.strip()
    except:
        return ""

def animar_progresso(etapa, progresso_atual, total_etapas):
