    porcentagem = int((progresso_atual / total_etapas) * 100)
    blocos = int(porcentagem / 5)
    # Barra estilizada usando blocos cheios e vazios (CORRIGIDO: 'blocos' em toda a estrutura)
    barra = "█" * blocos + "░" * (20 - blocos)
    
    exibir_banner()
    print(f"\n\033[1;34m: [ {barra} ]  {porcentagem}%  00:04  {progresso_atual}/{total_etapas}\033[0m")
    if progresso_atual > 1:
        print(f"\033[1;32m✓ Módulos anteriores verificados com integridade.\033[0m")
    else:
        print(f"\033[1;37m Inicializando rotinas de segurança...\033[0m")
    print(f"\033[1;33m➤ {etapa}...\033[0m")
    time.sleep(1.4)

